{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graderprobe.dev/schemas/frozen_cohort.schema.json",
  "title": "GraderProbe frozen candidate cohort",
  "type": "object",
  "required": ["schema", "anchors"],
  "properties": {
    "schema": {"const": "graderprobe.frozen_cohort.v1"},
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task", "candidate"],
        "properties": {
          "task": {"type": "string", "minLength": 1},
          "candidate": {"type": "string", "minLength": 1},
          "label": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
